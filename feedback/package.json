        "@ar-training/shared": "file:../shared",
        "fastify": "^5.8.1"
    },
    "devDependencies": {
        "@types/node": "^22.0.0",
        "@vitest/ui": "^3.1.2",
        "typescript": "^5.9.3",
        "vitest": "^3.1.2"
    }
}