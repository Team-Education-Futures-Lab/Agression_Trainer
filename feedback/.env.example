# ── Required ──────────────────────────────────────────────────────────────────
# Shared secret — must match the value in app/.env and all other containers.
# Generate with: openssl rand -hex 32
INTERNAL_API_KEY=CHANGE_ME

# ── Feedback implementation ───────────────────────────────────────────────────
# stub       — canned Dutch response, no Ollama required (default)
# production — calls Ollama to generate real debrief advice
FEEDBACK_GENERATOR=stub

# ── Ollama (only used when FEEDBACK_GENERATOR=production) ────────────────────
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=llama3.2

# How long to wait for a generation request before aborting (ms).
OLLAMA_TIMEOUT_MS=120000

# How long to wait for a model pull to complete at startup (ms).
# Large models can take several minutes; the default is 10 minutes.
OLLAMA_PULL_TIMEOUT_MS=600000

# Optional — SHA-256 digest of the expected model manifest.
# Format: sha256:<64 hex chars>
# When set, the container verifies the pulled model matches this digest at
# startup. If it does not match, startup fails with a clear error.
# When unset, digest verification is skipped (acceptable for development).
#
# Recommended for production deployments to prevent a compromised or
# substituted registry entry from causing an unintended model to be used.
#
# Obtain the correct value by running: ollama show <model>
# and copying the "digest" field, e.g.:
#   OLLAMA_MODEL_DIGEST=sha256:a80c4f17acd55265feec403c7aef86be0c25983ab279d83f3bcd3abbcb5b8b72
#OLLAMA_MODEL_DIGEST=

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8002