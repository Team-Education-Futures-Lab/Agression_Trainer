# =============================================================================
# AR Training — Evaluation Container — Environment Variables
# Copy this file to .env and fill in the values before running locally.
# Never commit .env to version control.
#
# Generate INTERNAL_API_KEY with: openssl rand -hex 32
# Must match the value set in app/.env and all other containers.
# =============================================================================

# ── Required ──────────────────────────────────────────────────────────────────

INTERNAL_API_KEY=CHANGE_ME

# ── Optional (defaults shown) ─────────────────────────────────────────────────

# Which analyser implementation to use.
# stub        — deterministic hardcoded results, no model required (default)
# production  — real multimodal classifier
BEHAVIOUR_ANALYSER=stub

# Inference device for the production classifier.
# cpu   — no GPU required (default)
# cuda  — requires NVIDIA Container Toolkit
DEVICE=cpu

# Internal listen port.
PORT=8001

# Path to the TOML tuning config file.
# Controls signal thresholds and Dutch lexical de-escalation patterns used
# by the production BehaviourAnalyser. Expected format: TOML.
# The file must exist at startup when BEHAVIOUR_ANALYSER=production;
# it is also validated on startup when BEHAVIOUR_ANALYSER=stub so that
# config errors are caught early.
# Default: evaluation_config.toml in the same directory as this .env file.
# Override if the file lives elsewhere (e.g. in a shared config volume).
# EVALUATION_CONFIG=evaluation_config.toml