# ── Required ──────────────────────────────────────────────────────────────────
# Must match INTERNAL_API_KEY in all other containers.
# Generate with: openssl rand -hex 32
INTERNAL_API_KEY=CHANGE_ME

# ── Pool implementation ───────────────────────────────────────────────────────
# "stub"       — returns canned transcript text; no Whisper required
# "production" — real faster-whisper pool (Phase 2)
TRANSCRIPTION_POOL=stub

# ── Whisper settings (production only) ───────────────────────────────────────
WHISPER_MODEL=base
WHISPER_LANGUAGE=nl
WHISPER_WORKERS=4

# Beam search width passed to model.transcribe(). Higher = more accurate but
# proportionally slower (roughly N forward passes per decoding step vs 1 for
# beam_size=1/greedy). Lower this if GPU transcription latency is too high.
WHISPER_BEAM_SIZE=5

# Seconds of audio buffered before a rolling window is sent to Whisper (min 1).
# While a student speaks, audio is transcribed in windows of this size; whatever
# is left when the clip ends is transcribed at finalise, so this is also the
# worst-case size of that last, blocking call. Lower = faster clip transition but
# more, shorter Whisper calls with less acoustic context (can hurt accuracy).
WHISPER_WINDOW_SECONDS=6

# ── Inference device ──────────────────────────────────────────────────────────
# "cpu" or "cuda" (requires NVIDIA Container Toolkit)
DEVICE=cpu

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8003