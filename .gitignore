# ── Environment ────────────────────────────────────────────────────────────
# Never commit secrets or local config overrides.
**/.env
**/.env.local
**/.env.*.local

# ── Models ────────────────────────────────────────────────────────────────
# Model files are large binaries that don't belong in git.
# Provide separately and document in CONTRIBUTING.md.
models/*

# ── OS files ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE ───────────────────────────────────────────────────────────────────
# VS Code workspace settings are user-specific.
.vscode/

# ── Logs ──────────────────────────────────────────────────────────────────
*.log
logs/

# ── Docker ────────────────────────────────────────────────────────────────
# Docker override files are typically local-only.
docker-compose.override.yml

# ── Database ──────────────────────────────────────────────────────────────
data

# ── Keep empty directories ─────────────────────────────────────────────────
# .gitkeep files are used to commit otherwise empty directories.
!**/.gitkeep