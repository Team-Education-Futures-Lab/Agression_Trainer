# ── Server ────────────────────────────────────────────────────────────────────

# Port the App container listens on internally.
PORT=3000

# ── Downstream services ───────────────────────────────────────────────────────

# Base URL of the Evaluation container.
# In Docker Compose this is the service name, e.g. http://evaluation:8001
EVALUATION_URL=http://evaluation:8001

# Base URL of the Feedback container.
# In Docker Compose this is the service name, e.g. http://feedback:8002
FEEDBACK_URL=http://feedback:8002

# ── Session management ────────────────────────────────────────────────────────

# Maximum number of concurrent active sessions.
# 32 comfortably supports a few classrooms in production.
# Use a low value (e.g. 2 or 3) during development to test capacity behaviour.
MAX_SESSIONS=32

# Maximum number of sessions allowed to wait in the queue.
MAX_QUEUE_SIZE=10

# What to do when at capacity.
# QUEUE: hold new sessions in a waiting room until a slot opens.
# REJECT: immediately return 503 to new sessions.
CAPACITY_POLICY=QUEUE

# How long to wait for a WebSocket connection after session creation (ms).
# If no WebSocket opens within this window, the session is dropped.
SESSION_TIMEOUT_MS=30000

# How long a dropped session can be resumed before it expires (ms).
RECOVERY_WINDOW_MS=30000

# ── Coordinator ───────────────────────────────────────────────────────────────

# Duration of each analysis window in milliseconds.
WINDOW_MS=2000

# Minimum number of frames required to dispatch a window.
# Windows below this threshold are discarded (likely due to packet loss).
# At ~30fps over 2 seconds, a full window is ~60 frames. 10 is a safe minimum.
MIN_FRAMES_PER_WINDOW=10
