# ── Server ────────────────────────────────────────────────────────────────────

# Port the App container listens on internally.
PORT=3000

# ── Downstream services ───────────────────────────────────────────────────────

# Base URL(s) of the Evaluation container.
# Comma-separated list enables multi-instance load distribution with session
# pinning. In Docker Compose this is the service name.
EVALUATION_URLS=http://evaluation:8001

# Base URL(s) of the Transcription container.
# Comma-separated list supported for multi-instance setups.
TRANSCRIPTION_URLS=http://transcription:8003

# Base URL of the Feedback container.
FEEDBACK_URL=http://feedback:8002

# Path to the scenarios directory, mounted into the container at runtime.
# In Docker Compose this maps to the repo's scenarios/ directory.
SCENARIOS_DIR=/app/scenarios

# ── Security ──────────────────────────────────────────────────────────────────

# Shared secret sent as `Authorization: Bearer` on all requests from the App
# container to the Evaluation, Transcription, and Feedback containers. Those
# services reject any request that does not carry this key.
#
# Generate with: openssl rand -hex 32
# Must match the value set in all other containers' .env files.
INTERNAL_API_KEY=CHANGE_ME

# Optional admin API key. When set, POST /session/create requests carrying
# `Authorization: Bearer <value>` create admin sessions. Admin sessions:
#   - may activate any clip, not just the scenario entry clip
#   - receive `debug_eval` messages after each clip_selected, carrying the
#     full BehaviourResult and implementation-specific stage intermediates
#
# When unset, admin mode is permanently unavailable.
# Generate with: openssl rand -hex 32
# Enter this value in the "Admin key" field of the debug harness to use it.
#ADMIN_API_KEY=CHANGE_ME

# ── Session management ────────────────────────────────────────────────────────

# Maximum number of concurrent active sessions.
# 32 comfortably supports a few classrooms in production.
# Use a low value (e.g. 2 or 3) during development to test capacity behaviour.
MAX_SESSIONS=32

# Maximum number of sessions allowed to wait in the queue.
MAX_QUEUE_SIZE=10

# What to do when at capacity.
# QUEUE: hold new sessions in a waiting room until a slot opens.
# REJECT: immediately return 503 to new sessions.
CAPACITY_POLICY=QUEUE

# How long to wait for a WebSocket connection + activation after session
# creation before dropping the session (ms).
SESSION_TIMEOUT_MS=30000

# How long a dropped session can be resumed before it expires (ms).
RECOVERY_WINDOW_MS=30000

# How long to wait for the full feedback SSE stream before treating it as
# unavailable (ms). Should exceed the Feedback container's OLLAMA_TIMEOUT_MS
# so that Ollama times out first and the SSE stream closes cleanly.
FEEDBACK_TIMEOUT_MS=150000

# ── CORS ──────────────────────────────────────────────────────────────────────

# When unset, HTTP endpoints accept requests from any origin — correct for
# single-server classroom use where the client and app share a host.
# Set to a specific origin (e.g. http://localhost:3000) in multi-host or
# internet-facing deployments.
#CORS_ORIGIN=