# ── Server ────────────────────────────────────────────────────────────────────

# Port the App container listens on internally.
PORT=3000

# ── Downstream services ───────────────────────────────────────────────────────

# Base URL(s) of the Evaluation container.
# Comma-separated list enables multi-instance load distribution with session
# pinning. In Docker Compose this is the service name.
EVALUATION_URLS=http://evaluation:8001

# Base URL(s) of the Transcription container.
# Comma-separated list supported for multi-instance setups.
TRANSCRIPTION_URLS=http://transcription:8003

# Base URL of the Feedback container.
FEEDBACK_URL=http://feedback:8002

# Path to the scenarios directory, mounted into the container at runtime.
# In Docker Compose this maps to the repo's scenarios/ directory.
SCENARIOS_DIR=/app/scenarios

# ── Security ──────────────────────────────────────────────────────────────────

# Shared secret sent as `Authorization: Bearer` on all requests from the App
# container to the Evaluation, Transcription, and Feedback containers. Those
# services reject any request that does not carry this key.
#
# Generate with: openssl rand -hex 32
# Must match the value set in all other containers' .env files.
INTERNAL_API_KEY=CHANGE_ME

# Optional legacy admin API key. When set, it is accepted as a backwards-
# compatible fallback for:
#   - POST /scenarios (scenario upload from tooling that predates JWT auth)
#
# For new deployments, leave this unset and use POST /auth/login to obtain an
# admin JWT instead. The JWT path is the primary mechanism.
#
# NOTE: This key is no longer used for POST /session/create — admin sessions
# are now created by logging in with an admin account and passing the JWT.
#
# Generate with: openssl rand -hex 32
#ADMIN_API_KEY=CHANGE_ME

# ── Authentication ────────────────────────────────────────────────────────────

# Secret used to sign and verify JWTs. Required.
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME

# JWT expiry duration. Supports shorthand: 8h (hours), 30m (minutes), 1d (days).
# Default: 8h — a typical school day. Tokens expire at the end of a session.
JWT_EXPIRY=8h

# Path inside the container where the SQLite auth database (auth.db) is stored.
# Must be a bind-mounted directory so the database persists across container
# recreations. The ./data directory is bind-mounted to this path in
# docker-compose.yml.
DATA_DIR=/app/data

# When true, POST /auth/register is open for self-registration.
# Default: false — in production, an admin creates accounts manually via
# POST /auth/register with an admin JWT (which allows setting role=admin).
# Set to true only during development or initial setup.
ALLOW_REGISTRATION=false

# Bootstrap admin account (first-startup only).
#
# If the users table is empty when the App container starts AND both of these
# variables are set, a single admin account is created automatically with these
# credentials. This avoids the chicken-and-egg problem of needing an admin
# account to register the first admin account.
#
# IMPORTANT: Unset both variables (or leave them commented out) after the first
# admin account has been created. They are ignored once any user exists in the
# database, but leaving them set in .env is unnecessary and stores plaintext
# credentials.
#
# Minimum password length: 8 characters.
#BOOTSTRAP_ADMIN_USERNAME=admin
#BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME

# ── Session management ────────────────────────────────────────────────────────

# Maximum number of concurrent active sessions.
# 32 comfortably supports a few classrooms in production.
# Use a low value (e.g. 2 or 3) during development to test capacity behaviour.
MAX_SESSIONS=32

# Maximum number of sessions allowed to wait in the queue.
MAX_QUEUE_SIZE=10

# What to do when at capacity.
# QUEUE: hold new sessions in a waiting room until a slot opens.
# REJECT: immediately return 503 to new sessions.
CAPACITY_POLICY=QUEUE

# How long to wait for a WebSocket connection + activation after session
# creation before dropping the session (ms).
SESSION_TIMEOUT_MS=30000

# How long a dropped session can be resumed before it expires (ms).
RECOVERY_WINDOW_MS=30000

# How long to wait for the full feedback SSE stream before treating it as
# unavailable (ms). Should exceed the Feedback container's OLLAMA_TIMEOUT_MS
# so that Ollama times out first and the SSE stream closes cleanly.
FEEDBACK_TIMEOUT_MS=150000

# ── CORS ──────────────────────────────────────────────────────────────────────

# When unset, HTTP endpoints accept requests from any origin — correct for
# single-server classroom use where the client and app share a host.
# Set to a specific origin (e.g. http://localhost:3000) in multi-host or
# internet-facing deployments.
#CORS_ORIGIN=

# ── Developer tools (client build only) ──────────────────────────────────────
#
# The dev tools page (/devtools.html) is a build-time opt-in, not a runtime
# setting. To include it in a local development build, pass VITE_DEV_TOOLS=true
# to `vite build`:
#
#   VITE_DEV_TOOLS=true vite build
#
# This is intentionally NOT an entry in this .env file. It is a Vite build-time
# flag, not a server runtime variable, and must never be set in a CI or
# production build pipeline.
#
# The server-side endpoint guard (DEV_TOOLS_ENABLED) is set exclusively via the
# docker compose devtools profile and must never appear in this file. To enable
# both the page and the endpoints for local development:
#
#   docker compose --profile devtools up
