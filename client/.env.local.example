# Client environment variables for local development.
# Copy this file to .env.local and adjust as needed.
# .env.local is never committed to version control.
#
# These variables are only used when running the client dev server directly
# via `npm run dev`. When running through Docker, the App container URL is
# handled by nginx proxy configuration instead.

# WebSocket URL for the App container
VITE_APP_WS_URL=ws://localhost:8000

# HTTP URL for the App container
VITE_APP_HTTP_URL=http://localhost:8000
