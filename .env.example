# .env.example
# Copy this to .env and update values

# ==================== Server Configuration ====================
HOST=0.0.0.0
PORT=5000
DEBUG=false

# ==================== Database Configuration ====================
DATABASE_URL=postgresql://ar_training:password@localhost:5432/ar_training_db

# ==================== Redis Configuration ====================
REDIS_URL=redis://localhost:6379/0

# ==================== AI Model Configuration ====================
# Paths are relative to project root
EMOTION_MODEL_PATH=assets/models/emotion_model.h5
GESTURE_MODEL_PATH=assets/models/gesture_model.tflite
VOICE_MODEL_PATH=assets/models/voice_emotion_model.h5
WHISPER_MODEL_SIZE=base
WHISPER_CACHE_DIR=assets/models/whisper

# ==================== Scenario Configuration ====================
SCENARIOS_PATH=assets/scenarios

# ==================== Ollama LLM Configuration ====================
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_TIMEOUT=30

# ==================== Performance Configuration ====================
MAX_CONCURRENT_STUDENTS=50
WHISPER_WORKER_THREADS=4

# ==================== Security Configuration ====================
# IMPORTANT: Change this in production!
JWT_SECRET=your-super-secret-key-min-32-characters-long
CORS_ORIGINS=http://localhost:3000,https://your-frontend.com

# ==================== Logging Configuration ====================
LOG_LEVEL=INFO
LOG_FILE=logs/ar_training.log

# ==================== Feature Flags ====================
ENABLE_TRANSCRIPTION=true
ENABLE_OLLAMA=true