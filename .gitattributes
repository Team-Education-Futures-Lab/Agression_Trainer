# ── Git LFS ────────────────────────────────────────────────────────────────
# Video files are stored in Git LFS rather than the repository directly.
# Requires git-lfs to be installed: https://git-lfs.github.com
scenarios/**/*.mp4   filter=lfs diff=lfs merge=lfs -text
scenarios/**/*.mov   filter=lfs diff=lfs merge=lfs -text
scenarios/**/*.webm  filter=lfs diff=lfs merge=lfs -text
# ── Line endings ───────────────────────────────────────────────────────────
# Normalise line endings to LF on commit across all platforms.
* text=auto eol=lf
# Binary files — never diff or merge these.
*.pkl    binary
*.pt     binary
*.onnx   binary
*.mp4 filter=lfs diff=lfs merge=lfs -text
